{
  "name": "@ryze-digital/mega-menu",
  "description": "Creates a multi-column and multi-level flyout navigation",
  "license": "MIT",
  "version": "1.0.0-beta.1",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "index.js",
  "type": "module",
  "repository": "github:ryze-digital/mega-menu",
  "config": {
    "output": "demos/build"
  },
  "scripts": {
    "lint": "npm-run-all --parallel lint:*",
    "lint:scripts": "eslint {src,tests}/scripts/**",
    "lint:styles": "stylelint src/styles/**",
    "lint-fix": "npm-run-all --parallel lint-fix:*",
    "lint-fix:scripts": "npm run lint:scripts -- --fix",
    "lint-fix:styles": "prettier src/styles/** --write && npm run lint:styles -- --fix",
    "test": "npm run test:scripts",
    "test:scripts": "jest",
    "test:scripts:coverage": "jest --coverage",
    "build": "npm-run-all --parallel lint:* build:* --continue-on-error",
    "build:scripts": "webpack",
    "build:styles": "npm-run-all sass:build",
    "watch": "npm-run-all --parallel watch:*",
    "watch:scripts": "webpack --watch",
    "watch:styles": "npm-run-all --parallel sass:watch",
    "sass:build": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules",
    "sass:watch": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules --load-path=src/styles --watch --poll",
    "prebuild": "node pre-build.js"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^1.0.0",
    "@ryze-digital/prettier-config-website": "^1.0.1",
    "@ryze-digital/stylelint-config-website": "^1.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@ryze-digital/js-utilities": "^1.0.0-beta.0",
    "@ryze-digital/scss-utilities": "^1.0.0-beta.0"
  }
}
